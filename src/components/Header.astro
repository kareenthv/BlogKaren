---
import Menu from './Menu.astro';
import Navigation from './Navigation.astro';
import ThemeIcon from './ThemeIcon.astro';
---

<header>
    <nav>
        <div class="nav-controls">
            <ThemeIcon />
            <Menu />
        </div>
        <Navigation />
    </nav>
</header>

<style>
    header {
        width: 100%;
    }

    nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background: rgba(255, 248, 238, 0.95);
        backdrop-filter: blur(10px);
        padding: 1.2rem 2rem;
        z-index: 999;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .nav-controls {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    :global(.dark) nav {
        background: rgba(13, 9, 80, 0.95);
    }
</style>