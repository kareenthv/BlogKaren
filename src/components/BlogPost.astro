---
const { url, title } = Astro.props;
---
<li><a href={url}>{title}</a></li>

<style>
    a {
        text-decoration: none;
        color: var(--burgundy);
        font-weight: 500;
        transition: all 0.3s ease;
    }

    a:hover {
        color: var(--pink-soft);
        text-decoration: underline;
    }
</style>