---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Mi blog de Astro aprendizaje";
---
<BaseLayout pageTitle={pageTitle}>
    <style>
        .subtitle {
            text-align: center;
            color: var(--brown-soft);
            font-style: italic;
            margin-bottom: 2.5rem;
        }

        .posts-list {
            display: flex;
            flex-direction: column;
            gap: 1.2rem;
        }

        .post-card {
            display: block;
            background: white;
            border-radius: 18px;
            padding: 1.5rem 1.8rem;
            text-decoration: none;
            box-shadow: var(--shadow-soft);
            transition: all 0.3s ease;
            border-left: 4px solid var(--pink-soft);
        }

        .post-card:hover {
            transform: translateX(6px);
            box-shadow: var(--shadow-med);
        }

        .post-card h3 {
            color: var(--burgundy);
            font-size: 1.1rem;
            margin-bottom: 0.3rem;
        }

        .post-card p {
            font-size: 0.9rem;
            color: #6b5555;
        }
    </style>

    <p class="subtitle">Aquí es donde publicaré acerca de mi viaje aprendiendo Astro.</p>

    <div class="posts-list">
        <a href="/posts/post-1/" class="post-card">
            <h3>Publicación 1</h3>
            <p>Lo que pienso de Astro después de terminar el tutorial: me encantó.</p>
        </a>
    </div>
</BaseLayout>