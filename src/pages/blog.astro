---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Mi blog de Astro aprendizaje";

const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));

const sortedPosts = allPosts.sort((a: any, b: any) => 
  new Date(b.frontmatter.pubDate) - new Date(a.frontmatter.pubDate)
);
---
<BaseLayout pageTitle={pageTitle}>
    <style>
        .subtitle {
            text-align: center;
            color: var(--brown-soft);
            font-style: italic;
            margin-bottom: 2.5rem;
        }

        .posts-list {
            display: flex;
            flex-direction: column;
            gap: 1.2rem;
        }

        .post-card {
            display: block;
            background: white;
            border-radius: 18px;
            padding: 1.5rem 1.8rem;
            text-decoration: none;
            box-shadow: var(--shadow-soft);
            transition: all 0.3s ease;
            border-left: 4px solid var(--pink-soft);
        }

        .post-card:hover {
            transform: translateX(6px);
            box-shadow: var(--shadow-med);
        }

        .post-card h3 {
            color: var(--burgundy);
            font-size: 1.1rem;
            margin-bottom: 0.3rem;
        }

        .post-card p {
            font-size: 0.9rem;
            color: #6b5555;
            margin-bottom: 0.5rem;
        }

        .post-date {
            font-size: 0.85rem;
            color: var(--brown-soft);
            font-style: italic;
        }
    </style>

    <p class="subtitle">Aquí es donde publico acerca de mi viaje aprendiendo Astro.</p>

    <div class="posts-list">
        {sortedPosts.map((post: any) => (
            <a href={post.url} class="post-card">
                <h3>{post.frontmatter.title}</h3>
                <p>{post.frontmatter.description}</p>
                <div class="post-date">{post.frontmatter.pubDate.toString().slice(0,10)}</div>
            </a>
        ))}
    </div>
</BaseLayout>