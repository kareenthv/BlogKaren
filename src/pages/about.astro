    <!-- BOOKS SECTION -->
    <section id="libros">
        <h2 class="section-title">Historias & Mitología</h2>
        <div class="books-container">
            <div class="book" onclick="showEaster('achilles')">
                <span style="font-size: 2rem;">📕</span>
                <h4>La Canción de Aquiles</h4>
            </div>
            <div class="book">
                <span style="font-size: 2rem;">📗</span>
                <h4>Ennead</h4>
            </div>
            <div class="book">
                <span style="font-size: 2rem;">📕</span>
                <h4>Berserk</h4>
            </div>
            <div class="book">
                <span style="font-size: 2rem;">📘</span>
                <h4>Mitología Egipcia</h4>
            </div>
            <div class="book">
                <span style="font-size: 2rem;">📙</span>
                <h4>BL & Romance</h4>
            </div>
            <div class="book">
                <span style="font-size: 2rem;">📕</span>
                <h4>Psicología del alma</h4>
            </div>
        </div>

        <div class="quote-box" onclick="rotateQuote()">
            <p class="quote-text" id="quote-display">"Un personaje complicado es un libro que nunca termino de leer"</p>
        </div>
