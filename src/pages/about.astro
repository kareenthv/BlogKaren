<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Karen's Universe</title>
    <style>
        :root {
            --pink-pastel: #F8DDEB;
            --pink-soft: #F4C7D7;
            --pink-muted: #E8B4C8;
            --lavender: #E6D5F0;
            --mint: #D5F0E8;
            --peach: #F5E0D0;
            --yellow-pastel: #FFF9D9;
            --cream: #FFF8EE;
            --beige: #E8D8C3;
            --brown-soft: #C89F9C;
            --burgundy: #8F4F5F;
            --blue-pastel: #AFC6D8;
            
            --shadow-soft: 0 8px 24px rgba(0, 0, 0, 0.06);
            --shadow-med: 0 12px 32px rgba(0, 0, 0, 0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #FFF9F5 0%, #F5F0FF 50%, #F0F8F8 100%);
            color: #4a3d3d;
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* NAVEGACIÓN */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: rgba(255, 248, 238, 0.95);
            backdrop-filter: blur(10px);
            padding: 1.2rem 2rem;
            display: flex;
            justify-content: center;
            gap: 2rem;
            z-index: 999;
            box-shadow: var(--shadow-soft);
        }

        nav a {
            text-decoration: none;
            color: var(--burgundy);
            font-weight: 500;
            font-size: 0.95rem;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            transition: all 0.3s ease;
            position: relative;
        }

        nav a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--pink-soft), var(--peach));
            transition: width 0.3s ease;
        }

        nav a:hover {
            background: rgba(248, 221, 235, 0.3);
        }

        nav a:hover::after {
            width: 100%;
        }

        /* HERO SECTION */
        .hero {
            margin-top: 80px;
            min-height: calc(100vh - 80px);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            padding: 2rem;
            z-index: 1;
        }

        .hero-content {
            text-align: center;
            position: relative;
            z-index: 2;
            max-width: 700px;
            animation: fadeInUp 1s ease-out;
        }

        .hero h1 {
            font-size: 3.5rem;
            color: var(--burgundy);
            margin-bottom: 0.5rem;
            font-weight: bold;
            letter-spacing: -1px;
            line-height: 1;
        }

        .hero-subtitle {
            font-size: 1.3rem;
            color: var(--brown-soft);
            margin-bottom: 1.5rem;
            font-weight: 300;
            letter-spacing: 1px;
        }

        .hero-tagline {
            font-size: 1rem;
            color: #6b5555;
            margin-bottom: 2.5rem;
            line-height: 1.8;
            font-style: italic;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .hero-decor {
            position: absolute;
            font-size: 2.5rem;
            opacity: 0.4;
            animation: float 3s ease-in-out infinite;
            pointer-events: none;
        }

        .decor-1 { top: 10%; left: 5%; animation-delay: 0s; }
        .decor-2 { top: 15%; right: 8%; animation-delay: 1s; }
        .decor-3 { bottom: 20%; left: 10%; animation-delay: 0.5s; }
        .decor-4 { bottom: 15%; right: 10%; animation-delay: 1.5s; }
        .decor-5 { top: 30%; right: 5%; animation-delay: 0.8s; }
        .decor-6 { bottom: 25%; left: 20%; animation-delay: 1.2s; }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .cta-button {
            display: inline-block;
            padding: 12px 32px;
            background: linear-gradient(135deg, var(--pink-soft), var(--peach));
            color: var(--burgundy);
            text-decoration: none;
            border-radius: 30px;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            box-shadow: var(--shadow-soft);
        }

        .cta-button:hover {
            background: linear-gradient(135deg, var(--burgundy), var(--brown-soft));
            color: var(--cream);
            transform: translateY(-2px);
            box-shadow: var(--shadow-med);
        }

        .scroll-indicator {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            animation: bounce 2s infinite;
            font-size: 1.5rem;
        }

        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); }
            40% { transform: translateX(-50%) translateY(-10px); }
            60% { transform: translateX(-50%) translateY(-5px); }
        }

        /* SECTIONS */
        section {
            padding: 80px 2rem;
            position: relative;
            z-index: 1;
        }

        .section-title {
            font-size: 2.5rem;
            color: var(--burgundy);
            text-align: center;
            margin-bottom: 3rem;
            position: relative;
            padding-bottom: 1.5rem;
            font-weight: bold;
        }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 3px;
            background: linear-gradient(90deg, var(--pink-soft), var(--peach), var(--lavender));
            border-radius: 2px;
        }

        /* THINGS I LOVE SECTION */
        .things-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .love-card {
            border-radius: 20px;
            padding: 2rem;
            text-align: center;
            box-shadow: var(--shadow-soft);
            transition: all 0.4s ease;
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .love-card:nth-child(1) { background: linear-gradient(135deg, #FFF5F8, #FFE8F0); }
        .love-card:nth-child(2) { background: linear-gradient(135deg, #FFF9F5, #F5E8E0); }
        .love-card:nth-child(3) { background: linear-gradient(135deg, #F5F8FF, #E8F0FF); }
        .love-card:nth-child(4) { background: linear-gradient(135deg, #F8FFF5, #E8FFE8); }
        .love-card:nth-child(5) { background: linear-gradient(135deg, #FFF8F5, #F5F0FF); }
        .love-card:nth-child(6) { background: linear-gradient(135deg, #F5F5F8, #E8E8FF); }

        .love-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-med);
        }

        .love-card-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            display: inline-block;
        }

        .love-card h3 {
            font-size: 1.3rem;
            color: var(--burgundy);
            margin-bottom: 0.8rem;
            font-weight: 600;
        }

        .love-card p {
            font-size: 0.95rem;
            color: #6b5555;
            line-height: 1.7;
        }

        /* MUSIC SECTION */
        .music-section {
            background: linear-gradient(135deg, rgba(230, 213, 240, 0.3), rgba(213, 240, 232, 0.3));
            border-radius: 30px;
            padding: 80px 2rem;
        }

        .vinyl-player {
            max-width: 400px;
            margin: 0 auto 3rem;
            text-align: center;
        }

        .vinyl {
            width: 200px;
            height: 200px;
            margin: 0 auto 2rem;
            background: radial-gradient(circle at 30% 30%, #1a1a1a, #000);
            border-radius: 50%;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3), inset -5px -5px 15px rgba(0, 0, 0, 0.5);
            position: relative;
            animation: spin 4s linear infinite;
        }

        .vinyl::before {
            content: '';
            position: absolute;
            width: 60px;
            height: 60px;
            background: radial-gradient(circle at 40% 40%, #f0e68c, #daa520);
            border-radius: 50%;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 2;
        }

        .vinyl::after {
            content: '';
            position: absolute;
            width: 15px;
            height: 15px;
            background: #1a1a1a;
            border-radius: 50%;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 3;
        }

        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .music-artists {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
            max-width: 1000px;
            margin-left: auto;
            margin-right: auto;
        }

        .artist-card {
            background: white;
            padding: 1.5rem;
            border-radius: 15px;
            text-align: center;
            box-shadow: var(--shadow-soft);
            transition: all 0.3s ease;
            border: 1px solid rgba(230, 213, 240, 0.3);
        }

        .artist-card:hover {
            transform: scale(1.05);
            box-shadow: var(--shadow-med);
        }

        .artist-card h4 {
            font-size: 0.95rem;
            color: var(--burgundy);
            margin-top: 0.8rem;
            font-weight: 600;
        }

        /* BOOKS SECTION */
        .books-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1.5rem;
            max-width: 1000px;
            margin: 0 auto;
        }

        .book {
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            box-shadow: var(--shadow-soft);
            transition: all 0.3s ease;
            cursor: pointer;
            position: relative;
        }

        .book:nth-child(1) { background: linear-gradient(135deg, var(--pink-soft), var(--pink-muted)); }
        .book:nth-child(2) { background: linear-gradient(135deg, var(--lavender), #D9CCF0); }
        .book:nth-child(3) { background: linear-gradient(135deg, #2a1a1a, #4a3a3a); color: #ddd; }
        .book:nth-child(4) { background: linear-gradient(135deg, var(--mint), #B8E8E0); }
        .book:nth-child(5) { background: linear-gradient(135deg, var(--peach), #E8D0C0); }
        .book:nth-child(6) { background: linear-gradient(135deg, var(--yellow-pastel), #F5F0D9); }

        .book:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-med);
        }

        .book h4 {
            font-size: 0.9rem;
            color: inherit;
            margin-top: 0.8rem;
            font-weight: 600;
        }

        .quote-box {
            text-align: center;
            margin: 3rem auto;
            padding: 2rem;
            background: white;
            border-radius: 15px;
            border-left: 4px solid var(--pink-soft);
            cursor: pointer;
            transition: all 0.3s ease;
            max-width: 700px;
            box-shadow: var(--shadow-soft);
        }

        .quote-box:hover {
            box-shadow: var(--shadow-med);
            transform: translateX(5px);
        }

        .quote-text {
            font-size: 1.1rem;
            color: var(--burgundy);
            font-style: italic;
            min-height: 50px;
            line-height: 1.8;
            transition: opacity 0.3s ease;
        }

        /* CAT SECTION */
        .cat-section {
            background: linear-gradient(135deg, rgba(255, 245, 248, 0.8), rgba(245, 248, 255, 0.8));
            border-radius: 30px;
            padding: 80px 2rem;
        }

        .cat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
            max-width: 1000px;
            margin-left: auto;
            margin-right: auto;
        }

        .cat-card {
            background: white;
            border-radius: 20px;
            box-shadow: var(--shadow-soft);
            transition: all 0.3s ease;
            text-align: center;
            padding: 2rem;
            position: relative;
            overflow: hidden;
        }

        .cat-card:nth-child(1) { border-top: 4px solid var(--pink-soft); }
        .cat-card:nth-child(2) { border-top: 4px solid var(--peach); }
        .cat-card:nth-child(3) { border-top: 4px solid var(--blue-pastel); }

        .cat-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-med);
        }

        .cat-emoji {
            font-size: 3.5rem;
            margin-bottom: 1rem;
        }

        .cat-card h4 {
            color: var(--burgundy);
            margin-bottom: 0.5rem;
            font-weight: 600;
            font-size: 1.2rem;
        }

        .cat-card p {
            font-size: 0.9rem;
            color: #6b5555;
            line-height: 1.6;
        }

        /* UNIVERSE SECTION */
        .universe-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 1.5rem;
            max-width: 1100px;
            margin: 0 auto;
        }

        .universe-item {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            text-align: center;
            box-shadow: var(--shadow-soft);
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

        .universe-item:hover {
            border-color: var(--pink-soft);
            transform: scale(1.05);
            box-shadow: var(--shadow-med);
        }

        .universe-item span {
            font-size: 2.5rem;
            display: block;
            margin-bottom: 0.8rem;
        }

        .universe-item p {
            font-size: 0.9rem;
            color: var(--burgundy);
            font-weight: 500;
        }

        /* FOOTER */
        footer {
            background: linear-gradient(135deg, var(--pink-soft), var(--lavender));
            color: var(--burgundy);
            text-align: center;
            padding: 3rem 2rem;
            margin-top: 2rem;
            position: relative;
            z-index: 1;
        }

        footer p {
            font-size: 1rem;
            margin-bottom: 0.8rem;
            font-style: italic;
            line-height: 1.6;
        }

        footer .footer-decor {
            font-size: 1.2rem;
            letter-spacing: 1rem;
            margin-top: 1.5rem;
            opacity: 0.7;
        }

        /* MODAL */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.4);
            animation: fadeIn 0.3s ease;
        }

        .modal.show {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background-color: var(--cream);
            padding: 2.5rem;
            border-radius: 20px;
            max-width: 500px;
            width: 90%;
            box-shadow: var(--shadow-med);
            animation: slideIn 0.3s ease;
        }

        .modal-content h2 {
            color: var(--burgundy);
            margin-bottom: 1rem;
            font-size: 1.5rem;
        }

        .modal-content p {
            color: #5a4a4a;
            line-height: 1.8;
        }

        .close-modal {
            float: right;
            font-size: 28px;
            font-weight: bold;
            color: var(--burgundy);
            cursor: pointer;
            transition: color 0.2s;
        }

        .close-modal:hover {
            color: var(--pink-muted);
        }

        @keyframes slideIn {
            from {
                transform: translateY(-50px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .heart-trail {
            position: fixed;
            pointer-events: none;
            font-size: 1.2rem;
            z-index: 999;
            animation: trailFade 1s ease-out forwards;
        }

        @keyframes trailFade {
            from {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
            to {
                opacity: 0;
                transform: translateY(-40px) scale(0.5);
            }
        }

        #cursor-cat {
            position: fixed;
            pointer-events: none;
            z-index: 998;
            font-size: 1.3rem;
            opacity: 0.7;
        }

        @media (max-width: 768px) {
            nav {
                gap: 1rem;
                padding: 1rem 1.5rem;
            }

            nav a {
                font-size: 0.85rem;
                padding: 0.4rem 0.8rem;
            }

            .hero h1 {
                font-size: 2.5rem;
            }

            .section-title {
                font-size: 2rem;
            }

            .things-grid {
                grid-template-columns: 1fr;
            }

            section {
                padding: 60px 1.5rem;
            }
        }
    </style>
</head>
<body>
    <nav>
        <a href="#inicio">Inicio</a>
        <a href="#amigos">Lo que amo</a>
        <a href="#musica">Música</a>
        <a href="#libros">Historias</a>
        <a href="#gatos">Mis gatos</a>
    </nav>

    <div id="cursor-cat"></div>

    <!-- HERO SECTION -->
    <section class="hero" id="inicio">
        <div class="hero-decor decor-1">✨</div>
        <div class="hero-decor decor-2">☕</div>
        <div class="hero-decor decor-3">📚</div>
        <div class="hero-decor decor-4">🎵</div>
        <div class="hero-decor decor-5">♟️</div>
        <div class="hero-decor decor-6">🌸</div>

        <div class="hero-content">
            <h1>Karen</h1>
            <p class="hero-subtitle">pequeño universo personal</p>
            <p class="hero-tagline">
                En algún rincón entre las tazas de café, las páginas de libros con historias que me atrapan, la música que me entiende, y tres gatos que son mi razón de sonreír. Así es mi mundo.
            </p>
            <button class="cta-button" onclick="smoothScroll('#amigos')">
                Conoce mi mundo
            </button>
        </div>

        <div class="scroll-indicator">↓</div>
    </section>

    <!-- THINGS I LOVE SECTION -->
    <section id="amigos">
        <h2 class="section-title">Cosas que amo</h2>
        <div class="things-grid">
            <div class="love-card" onclick="openModal('gatos-modal')">
                <div class="love-card-icon">🐱</div>
                <h3>Mis gatos</h3>
                <p>Michi, Mitsu y Tsuru Udon son mi santuario. Cada uno con su propia personalidad, sus manías y su forma de quererme.</p>
            </div>
            <div class="love-card" onclick="openModal('cafe-modal')">
                <div class="love-card-icon">☕</div>
                <h3>Cafeterías</h3>
                <p>Ese momento perfecto donde el café humeante, un libro abierto y la luz dorada crean la magia que necesito para pensar.</p>
            </div>
            <div class="love-card" onclick="openModal('ajedrez-modal')">
                <div class="love-card-icon">♟️</div>
                <h3>Ajedrez</h3>
                <p>No es solo un juego. Es estrategia, es arte, es la vida misma en forma de 64 casillas. Cada movimiento cuenta.</p>
            </div>
            <div class="love-card" onclick="openModal('libros-modal')">
                <div class="love-card-icon">📖</div>
                <h3>Historias</h3>
                <p>Las que me atrapan el alma. Personajes complejos, amores que duelen, mitologías reinterpretadas, psicología del corazón.</p>
            </div>
            <div class="love-card" onclick="openModal('musica-modal')">
                <div class="love-card-icon">🎵</div>
                <h3>Música</h3>
                <p>Mi lenguaje secreto. Lo que no puedo decir con palabras lo susurra en notas. BTS, Harry, Elvis, y ese misterio sonoro que me hipnotiza.</p>
            </div>
            <div class="love-card" onclick="openModal('anime-modal')">
                <div class="love-card-icon">🎬</div>
                <h3>Personajes oscuros</h3>
                <p>Arcane. Ghibli. Naruto. Los que tienen grietas, los que son más que lo que se ve. Eso es lo que me fascina.</p>
            </div>
        </div>
    </section>

    <!-- UNIVERSE SECTION -->
    <section>
        <h2 class="section-title">Mi pequeño universo</h2>
        <div class="universe-grid">
            <div class="universe-item">
                <span>📖</span>
                <p>Historias que enganchen</p>
            </div>
            <div class="universe-item">
                <span>🎬</span>
                <p>Cinematografía visual</p>
            </div>
            <div class="universe-item">
                <span>🎨</span>
                <p>Estética de ensueño</p>
            </div>
            <div class="universe-item">
                <span>💭</span>
                <p>Charlas profundas</p>
            </div>
            <div class="universe-item">
                <span>🌙</span>
                <p>Lo misterioso y raro</p>
            </div>
            <div class="universe-item">
                <span>🎭</span>
                <p>Personajes complejos</p>
            </div>
        </div>
    </section>

    <!-- MUSIC SECTION -->
    <section class="music-section" id="musica">
        <h2 class="section-title">Rincón de música</h2>
        <div class="vinyl-player">
            <div class="vinyl"></div>
            <p style="color: var(--burgundy); font-weight: 600; margin-bottom: 2rem;">Mi soundtrack</p>
        </div>
        
        <div class="music-artists">
            <div class="artist-card">
                <span style="font-size: 1.8rem;">🎤</span>
                <h4>BTS</h4>
            </div>
            <div class="artist-card">
                <span style="font-size: 1.8rem;">🎸</span>
                <h4>Harry Styles</h4>
            </div>
            <div class="artist-card">
                <span style="font-size: 1.8rem;">🎤</span>
                <h4>Elvis</h4>
            </div>
            <div class="artist-card">
                <span style="font-size: 1.8rem;">🌟</span>
                <h4>Michael Jackson</h4>
            </div>
            <div class="artist-card">
                <span style="font-size: 1.8rem;">🎙️</span>
                <h4>J. Cole</h4>
            </div>
            <div class="artist-card">
                <span style="font-size: 1.8rem;">🎵</span>
                <h4>Paulo Londra</h4>
            </div>
            <div class="artist-card">
                <span style="font-size: 1.8rem;">🎭</span>
