---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Sobre mí";

const identity = {
  firstName: "Karen",
  country: "México",
  occupation: "Estudiante en CETI Colomos",
  hobbies: ["café", "ajedrez", "gatos"],
};

const loves = [
  { icon: "🐱", title: "Mis gatos", text: "Michi, Mitsu y Tsuru Udon son mi santuario." },
  { icon: "☕", title: "Cafeterías", text: "Café humeante, un libro abierto y luz dorada." },
  { icon: "♟️", title: "Ajedrez", text: "Estrategia, arte y la vida misma en 64 casillas." },
  { icon: "📖", title: "Historias", text: "Personajes complejos y mitologías reinterpretadas." },
  { icon: "🎵", title: "Música", text: "BTS, Harry Styles, Elvis y ese misterio sonoro." },
  { icon: "🎬", title: "Personajes oscuros", text: "Arcane, Ghibli, Naruto: los que tienen grietas." },
];

const cats = [
  { emoji: "🐱", name: "Michi", text: "Elegante, observador, siempre sabe qué necesito." },
  { emoji: "🐈", name: "Mitsu", text: "El travieso, mi caos favorito." },
  { emoji: "🐈‍⬛", name: "Tsuru Udon", text: "Mi raro precioso, especial." },
];

const happy = true;
const finished = false;
const goal = 3;

const skills = ["HTML", "CSS", "JavaScript", "Java", "Android Studio", "Firebase", "Astro"];
const skillColor = "crimson";
const fontWeight = "bold";
const textCase = "uppercase";
---
<BaseLayout pageTitle={pageTitle}>
    <style is:global define:vars={{skillColor, fontWeight, textCase}}>
        .tagline {
            text-align: center;
            color: var(--brown-soft);
            font-style: italic;
            margin: 0.5rem 0 2.5rem;
        }

        .facts {
            background: white;
            border-radius: 18px;
            padding: 1.8rem;
            box-shadow: var(--shadow-soft);
            margin-bottom: 3rem;
        }

        .facts h2 {
            color: var(--burgundy);
            margin-bottom: 0.8rem;
            font-size: 1.2rem;
        }

        .facts ul {
            padding-left: 1.2rem;
            color: #6b5555;
        }

        .facts li {
            margin-bottom: 0.4rem;
        }

        .section-title {
            font-size: 1.8rem;
            color: var(--burgundy);
            text-align: center;
            margin-bottom: 2rem;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .card {
            background: white;
            border-radius: 18px;
            padding: 1.6rem;
            text-align: center;
            box-shadow: var(--shadow-soft);
            transition: all 0.3s ease;
        }

        .card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-med);
        }

        .card .icon {
            font-size: 2.3rem;
            margin-bottom: 0.6rem;
        }

        .card h3 {
            color: var(--burgundy);
            font-size: 1.05rem;
            margin-bottom: 0.4rem;
        }

        .card p {
            font-size: 0.88rem;
            color: #6b5555;
        }

        .skill {
            color: var(--skillColor);
            font-weight: var(--fontWeight);
            text-transform: var(--textCase);
        }
    </style>

    <p class="tagline">Un pequeño universo entre café, libros, música y gatos.</p>

    <section class="facts">
        <h2>Datos sobre mí</h2>
        <ul>
            <li>Me llamo {identity.firstName}.</li>
            <li>Vivo en {identity.country} y soy {identity.occupation}.</li>
            {identity.hobbies.length >= 2 &&
                <li>Dos de mis pasiones son: {identity.hobbies[0]} y {identity.hobbies[1]}</li>
            }
        </ul>
    </section>

    {happy && <p class="tagline">¡Estoy feliz de aprender Astro!</p>}
    {finished && <p class="tagline">¡Ya terminé este tutorial!</p>}
    {goal === 3 ? <p class="tagline">Mi meta es terminarlo en 3 días.</p> : <p class="tagline">Mi meta no son 3 días.</p>}

    <h2 class="section-title">Cosas que amo</h2>
    <div class="grid">
        {loves.map((item) => (
            <div class="card">
                <div class="icon">{item.icon}</div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
            </div>
        ))}
    </div>

    <h2 class="section-title">Mis gatos</h2>
    <div class="grid">
        {cats.map((cat) => (
            <div class="card">
                <div class="icon">{cat.emoji}</div>
                <h3>{cat.name}</h3>
                <p>{cat.text}</p>
            </div>
        ))}
    </div>

    <section class="facts">
        <h2>Mis habilidades</h2>
        <ul>
            {skills.map((skill) => <li class="skill">{skill}</li>)}
        </ul>
    </section>
</BaseLayout>