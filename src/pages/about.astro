<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Karen's Universe</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Poppins:wght@300;400;500;600&family=Cormorant+Garamond:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=block" rel="stylesheet">
    
    <style>
        :root {
            --primary-pink: #F8DDEB;
            --soft-pink: #F4C7D7;
            --muted-pink: #E8B4C8;
            --cream-light: #FFF4F7;
            --cream: #FFF8EE;
            --beige: #E8D8C3;
            --dusty-rose: #C89F9C;
            --burgundy: #8F4F5F;
            --warm-brown: #B88989;
            --pastel-blue: #AFC6D8;
            
            --shadow-soft: 0 8px 24px rgba(0, 0, 0, 0.08);
            --shadow-med: 0 12px 32px rgba(0, 0, 0, 0.1);
            --shadow-delicate: 0 4px 12px rgba(139, 79, 95, 0.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
            background: linear-gradient(135deg, var(--cream-light) 0%, var(--cream) 100%);
            color: #4a3d3d;
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* Decorative elements - scattered throughout */
        .bg-decoration {
            position: fixed;
            pointer-events: none;
            z-index: 0;
            opacity: 0.15;
        }

        /* HERO SECTION */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            padding: 2rem;
            z-index: 1;
        }

        .hero-content {
            text-align: center;
            position: relative;
            z-index: 2;
            max-width: 600px;
            animation: fadeInUp 1s ease-out;
        }

        .hero h1 {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: clamp(2.5rem, 8vw, 4rem);
            color: var(--burgundy);
            margin-bottom: 1rem;
            font-weight: 700;
            letter-spacing: -1px;
        }

        .hero-subtitle {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.5rem;
            color: var(--dusty-rose);
            margin-bottom: 2rem;
            font-weight: 400;
            letter-spacing: 1px;
        }

        .hero-tagline {
            font-size: 1.1rem;
            color: var(--warm-brown);
            margin-bottom: 2.5rem;
            line-height: 1.8;
            font-style: italic;
        }

        /* Decorative elements around hero */
        .hero-decor {
            position: absolute;
            font-size: 3rem;
            opacity: 0.6;
            animation: float 3s ease-in-out infinite;
        }

        .decor-cat { top: 10%; left: 5%; animation-delay: 0s; }
        .decor-coffee { top: 15%; right: 8%; animation-delay: 1s; font-size: 2.5rem; }
        .decor-star { bottom: 20%; left: 8%; animation-delay: 0.5s; }
        .decor-heart { bottom: 15%; right: 10%; animation-delay: 1.5s; color: var(--muted-pink); }
        .decor-book { top: 30%; right: 5%; animation-delay: 0.8s; font-size: 2.2rem; }
        .decor-music { bottom: 25%; left: 15%; animation-delay: 1.2s; }

        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(2deg); }
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* CTA BUTTON */
        .cta-button {
            display: inline-block;
            padding: 12px 32px;
            background: var(--soft-pink);
            color: var(--burgundy);
            text-decoration: none;
            border-radius: 30px;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            border: 2px solid var(--soft-pink);
            cursor: pointer;
            box-shadow: var(--shadow-soft);
        }

        .cta-button:hover {
            background: var(--burgundy);
            color: var(--cream);
            transform: translateY(-2px);
            box-shadow: var(--shadow-med);
        }

        /* SCROLL INDICATOR */
        .scroll-indicator {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); }
            40% { transform: translateX(-50%) translateY(-10px); }
            60% { transform: translateX(-50%) translateY(-5px); }
        }

        /* SECTIONS */
        section {
            padding: 60px 2rem;
            position: relative;
            z-index: 1;
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2rem, 5vw, 2.8rem);
            color: var(--burgundy);
            text-align: center;
            margin-bottom: 3rem;
            position: relative;
            padding-bottom: 1.5rem;
        }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--soft-pink), transparent);
        }

        /* THINGS I LOVE SECTION */
        .things-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .love-card {
            background: white;
            border-radius: 16px;
            padding: 2rem;
            text-align: center;
            box-shadow: var(--shadow-soft);
            transition: all 0.4s ease;
            border: 1px solid rgba(232, 212, 199, 0.3);
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .love-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, var(--primary-pink), var(--pastel-blue));
            opacity: 0;
            transition: opacity 0.4s ease;
            z-index: -1;
        }

        .love-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-med);
        }

        .love-card:hover::before {
            opacity: 0.05;
        }

        .love-card-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            display: inline-block;
        }

        .love-card h3 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.3rem;
            color: var(--burgundy);
            margin-bottom: 0.8rem;
            font-weight: 500;
        }

        .love-card p {
            font-size: 0.95rem;
            color: #6b5555;
            line-height: 1.6;
        }

        /* MUSIC CORNER */
        .music-section {
            background: linear-gradient(135deg, rgba(248, 221, 235, 0.4), rgba(175, 198, 216, 0.2));
            border-radius: 20px;
            padding: 3rem 2rem;
        }

        .vinyl-player {
            max-width: 400px;
            margin: 0 auto 2rem;
            text-align: center;
        }

        .vinyl {
            width: 200px;
            height: 200px;
            margin: 0 auto 2rem;
            background: radial-gradient(circle at 30% 30%, #1a1a1a, #000);
            border-radius: 50%;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3), inset -5px -5px 15px rgba(0, 0, 0, 0.5);
            position: relative;
            animation: spin 4s linear infinite;
        }

        .vinyl::before {
            content: '';
            position: absolute;
            width: 60px;
            height: 60px;
            background: radial-gradient(circle at 40% 40%, #f0e68c, #daa520);
            border-radius: 50%;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 2;
        }

        .vinyl::after {
            content: '';
            position: absolute;
            width: 15px;
            height: 15px;
            background: #1a1a1a;
            border-radius: 50%;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 3;
        }

        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .music-artists {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .artist-card {
            background: white;
            padding: 1.5rem;
            border-radius: 12px;
            text-align: center;
            box-shadow: var(--shadow-delicate);
            transition: all 0.3s ease;
            border: 1px solid rgba(200, 159, 156, 0.2);
        }

        .artist-card:hover {
            transform: scale(1.05);
            box-shadow: var(--shadow-soft);
        }

        .artist-card h4 {
            font-size: 1rem;
            color: var(--burgundy);
            margin-top: 0.5rem;
            font-weight: 600;
        }

        /* BOOKS SECTION */
        .books-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 1.5rem;
            max-width: 1000px;
            margin: 0 auto;
        }

        .book {
            background: linear-gradient(135deg, var(--muted-pink), var(--soft-pink));
            border-radius: 8px;
            padding: 1rem;
            text-align: center;
            box-shadow: var(--shadow-soft);
            transition: all 0.3s ease;
            cursor: pointer;
            position: relative;
        }

        .book:hover {
            transform: rotateY(5deg) translateY(-5px);
            box-shadow: var(--shadow-med);
        }

        .book h4 {
            font-size: 0.9rem;
            color: #3a2a2a;
            margin-top: 0.5rem;
            font-family: 'Cormorant Garamond', serif;
        }

        /* CAT CAFE SECTION */
        .cat-cafe {
            background: linear-gradient(135deg, rgba(255, 244, 247, 0.8), rgba(232, 221, 195, 0.4));
            border-radius: 20px;
            padding: 3rem 2rem;
        }

        .cat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }

        .cat-card {
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: var(--shadow-soft);
            transition: all 0.3s ease;
            text-align: center;
            padding: 1.5rem;
        }

        .cat-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-med);
        }

        .cat-emoji {
            font-size: 4rem;
            margin-bottom: 1rem;
        }

        .cat-card h4 {
            color: var(--burgundy);
            margin-bottom: 0.5rem;
            font-family: 'Cormorant Garamond', serif;
        }

        .cat-card p {
            font-size: 0.9rem;
            color: #6b5555;
        }

        /* MY LITTLE UNIVERSE SECTION */
        .universe-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 1.5rem;
            max-width: 1100px;
            margin: 0 auto;
        }

        .universe-item {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            box-shadow: var(--shadow-delicate);
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

        .universe-item:hover {
            border-color: var(--soft-pink);
            transform: scale(1.05);
            box-shadow: var(--shadow-soft);
        }

        .universe-item span {
            font-size: 2.5rem;
            display: block;
            margin-bottom: 0.5rem;
        }

        .universe-item p {
            font-size: 0.9rem;
            color: var(--burgundy);
            font-weight: 500;
        }

        /* EASTER EGGS */
        .easter-egg {
            position: relative;
            display: inline-block;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .easter-egg:hover {
            transform: scale(1.1);
        }

        .easter-popup {
            position: absolute;
            background: var(--soft-pink);
            color: var(--burgundy);
            padding: 0.8rem 1.2rem;
            border-radius: 20px;
            font-size: 0.85rem;
            white-space: nowrap;
            bottom: 120%;
            left: 50%;
            transform: translateX(-50%);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
            box-shadow: var(--shadow-soft);
            z-index: 100;
        }

        .easter-egg:hover .easter-popup {
            opacity: 1;
        }

        /* INTERACTIVE HEART TRAIL */
        .heart-trail {
            position: fixed;
            pointer-events: none;
            font-size: 1.5rem;
            z-index: 999;
            animation: trailFade 1s ease-out forwards;
        }

        @keyframes trailFade {
            from {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
            to {
                opacity: 0;
                transform: translateY(-40px) scale(0.5);
            }
        }

        /* FOOTER */
        footer {
            background: linear-gradient(135deg, var(--soft-pink), var(--muted-pink));
            color: var(--burgundy);
            text-align: center;
            padding: 3rem 2rem;
            margin-top: 2rem;
            position: relative;
            z-index: 1;
        }

        footer p {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.1rem;
            margin-bottom: 1rem;
            font-style: italic;
        }

        footer .footer-decor {
            font-size: 1.5rem;
            letter-spacing: 0.5rem;
        }

        /* MODAL */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.4);
            animation: fadeIn 0.3s ease;
        }

        .modal.show {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background-color: var(--cream);
            padding: 2rem;
            border-radius: 16px;
            max-width: 500px;
            width: 90%;
            box-shadow: var(--shadow-med);
            animation: slideIn 0.3s ease;
        }

        .modal-content h2 {
            color: var(--burgundy);
            margin-bottom: 1rem;
            font-family: 'Playfair Display', serif;
        }

        .modal-content p {
            color: #5a4a4a;
            line-height: 1.8;
        }

        .close-modal {
            float: right;
            font-size: 28px;
            font-weight: bold;
            color: var(--burgundy);
            cursor: pointer;
            transition: color 0.2s;
        }

        .close-modal:hover {
            color: var(--muted-pink);
        }

        @keyframes slideIn {
            from {
                transform: translateY(-50px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        /* QUOTE ROTATION */
        .quote-box {
            text-align: center;
            margin: 2rem 0;
            padding: 1.5rem;
            background: white;
            border-radius: 12px;
            border-left: 4px solid var(--soft-pink);
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .quote-box:hover {
            box-shadow: var(--shadow-soft);
            transform: translateX(5px);
        }

        .quote-text {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.2rem;
            color: var(--burgundy);
            font-style: italic;
            min-height: 40px;
            line-height: 1.8;
        }

        /* RESPONSIVE */
        @media (max-width: 768px) {
            .hero-decor {
                font-size: 2rem;
            }

            .things-grid {
                grid-template-columns: 1fr;
            }

            .music-artists {
                grid-template-columns: repeat(2, 1fr);
            }

            .vinyl {
                width: 150px;
                height: 150px;
            }

            section {
                padding: 40px 1.5rem;
            }
        }

        /* CUTE CURSOR TRAIL - hidden cats that follow */
        #cursor-cat {
            position: fixed;
            pointer-events: none;
            z-index: 998;
            font-size: 1.5rem;
            opacity: 0.6;
        }
    </style>
</head>
<body>
    <!-- Hidden cursor cat element -->
    <div id="cursor-cat"></div>

    <!-- HERO SECTION -->
    <section class="hero">
        <div class="hero-decor decor-cat">🐱</div>
        <div class="hero-decor decor-coffee">☕</div>
        <div class="hero-decor decor-star">✨</div>
        <div class="hero-decor decor-heart">💗</div>
        <div class="hero-decor decor-book">📖</div>
        <div class="hero-decor decor-music">♪</div>

        <div class="hero-content">
            <h1>Karen</h1>
            <p class="hero-subtitle">pequeño universo</p>
            <p class="hero-tagline">
                gatos, café, libros, música y cosas bonitas<br>
                (con un toque de misterio)
            </p>
            <button class="cta-button" onclick="smoothScroll('#things-i-love')">
                Explorar mi mundo
            </button>
        </div>

        <div class="scroll-indicator">
            <span style="font-size: 1.5rem;">↓</span>
        </div>
    </section>

    <!-- THINGS I LOVE SECTION -->
    <section id="things-i-love">
        <h2 class="section-title">Cosas que amo</h2>
        <div class="things-grid">
            <div class="love-card" onclick="openModal('gatos-modal')">
                <div class="love-card-icon">🐱</div>
                <h3>Gatitos</h3>
                <p>Tengo 3 gatos y son mi razón de existir. Pañitas, orejas, ronroneos.</p>
            </div>
            <div class="love-card" onclick="openModal('cafe-modal')">
                <div class="love-card-icon">☕</div>
                <h3>Café</h3>
                <p>La estética de una cafetería bonita es mi lugar feliz. Tazas, vapor, ambiente.</p>
            </div>
            <div class="love-card" onclick="openModal('ajedrez-modal')">
                <div class="love-card-icon">♟️</div>
                <h3>Ajedrez</h3>
                <p>Estrategia, belleza en el movimiento. ♞ ♛ ♜ ♝</p>
            </div>
            <div class="love-card" onclick="openModal('libros-modal')">
                <div class="love-card-icon">📚</div>
                <h3>Libros</h3>
                <p>Historias que enganchen, personajes complejos, romance, psicología, mitología.</p>
            </div>
            <div class="love-card" onclick="openModal('musica-modal')">
                <div class="love-card-icon">🎵</div>
                <h3>Música</h3>
                <p>BTS, Harry Styles, Elvis, Michael Jackson, y misterio sonoro.</p>
            </div>
            <div class="love-card" onclick="openModal('anime-modal')">
                <div class="love-card-icon">👹</div>
                <h3>Anime & Series</h3>
                <p>Arcane, Ghibli, Naruto. Personajes oscuros y complejos.</p>
            </div>
        </div>
    </section>

    <!-- MY LITTLE UNIVERSE SECTION -->
    <section>
        <h2 class="section-title">Mi pequeño universo</h2>
        <div class="universe-grid">
            <div class="universe-item">
                <span>📖</span>
                <p>Historias</p>
            </div>
            <div class="universe-item">
                <span>🎬</span>
                <p>Cinematografía</p>
            </div>
            <div class="universe-item">
                <span>🎨</span>
                <p>Estética</p>
            </div>
            <div class="universe-item">
                <span>💭</span>
                <p>Conversaciones profundas</p>
            </div>
            <div class="universe-item">
                <span>🌙</span>
                <p>Cosas misteriosas</p>
            </div>
            <div class="universe-item">
                <span>🎭</span>
                <p>Personajes complejos</p>
            </div>
            <div class="universe-item">
                <span>🌸</span>
                <p>Cosas bonitas</p>
            </div>
            <div class="universe-item easter-egg" onclick="showEaster('egypt')">
                <span>🏺</span>
                <p>Mitología<span class="easter-popup">Ennead ✨</span></p>
            </div>
            <div class="universe-item">
                <span>🖤</span>
                <p>Cosas raras</p>
            </div>
        </div>
    </section>

    <!-- MUSIC CORNER -->
    <section class="music-section">
        <h2 class="section-title">Rincón de música</h2>
        <div class="vinyl-player">
            <div class="vinyl"></div>
            <p style="color: var(--burgundy); font-weight: 600; margin-bottom: 2rem;">Mi soundtrack de vida</p>
        </div>
        
        <div class="music-artists">
            <div class="artist-card easter-egg" onclick="showEaster('bts')">
                <span style="font-size: 1.8rem;">🎤</span>
                <h4>BTS</h4>
                <span class="easter-popup">Taehyung 💜</span>
            </div>
            <div class="artist-card">
                <span style="font-size: 1.8rem;">🎸</span>
                <h4>Harry Styles</h4>
            </div>
            <div class="artist-card">
                <span style="font-size: 1.8rem;">🎤</span>
                <h4>Elvis</h4>
            </div>
            <div class="artist-card">
                <span style="font-size: 1.8rem;">🌟</span>
                <h4>Michael Jackson</h4>
            </div>
            <div class="artist-card">
                <span style="font-size: 1.8rem;">🎙️</span>
                <h4>J. Cole</h4>
            </div>
            <div class="artist-card">
                <span style="font-size: 1.8rem;">🎵</span>
                <h4>Paulo Londra</h4>
            </div>
            <div class="artist-card easter-egg" onclick="showEaster('slipknot')">
                <span style="font-size: 1.8rem;">🎭</span>
                <h4>Slipknot</h4>
                <span class="easter-popup">Lo raro que me encanta</span>
            </div>
            <div class="artist-card">
                <span style="font-size: 1.8rem;">🎻</span>
                <h4>Instrumental Mystery</h4>
            </div>
        </div>
    </section>

    <!-- BOOKS & STORIES SECTION -->
    <section>
        <h2 class="section-title">Libros & Historias</h2>
        <div class="books-container">
            <div class="book easter-egg" onclick="showEaster('achilles')">
                <span style="font-size: 2rem;">📕</span>
                <h4>La Canción de Aquiles<span class="easter-popup">Mi favorita 💕</span></h4>
            </div>
            <div class="book" style="background: linear-gradient(135deg, #D4A5A5, #E8C5C5);">
                <span style="font-size: 2rem;">📗</span>
                <h4>Ennead</h4>
            </div>
            <div class="book" style="background: linear-gradient(135deg, #2a1a1a, #4a3a3a); color: #ddd;">
                <span style="font-size: 2rem;">📕</span>
                <h4>Berserk</h4>
            </div>
            <div class="book" style="background: linear-gradient(135deg, #C8B4D4, #DCC9E0);">
                <span style="font-size: 2rem;">📘</span>
                <h4>Mitología Egipcia</h4>
            </div>
            <div class="book">
                <span style="font-size: 2rem;">📙</span>
                <h4>BL & Romance</h4>
            </div>
            <div class="book" style="background: linear-gradient(135deg, #E0D5B7, #F5E6C8);">
                <span style="font-size: 2rem;">📕</span>
