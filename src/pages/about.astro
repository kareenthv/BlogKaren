    <!-- FOOTER -->
    <footer>
        <p>En algún lugar entre el café y los libros, el ajedrez y la música,</p>
        <p>existe un pequeño universo que es completamente mío</p>
        <div class="footer-decor">
            🐱 ☕ 📚 🎵 🌸
        </div>
    </footer>

    <!-- MODALS -->
    <div id="gatos-modal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('gatos-modal')">&times;</span>
            <h2>Mis Gatitos</h2>
            <p>Tengo 3 gatos que son la luz de mis ojos. Son mi compañía, mi inspiración, mi razón de sonreír en los días grises. Pueden estar en cualquier parte de esta página como pequeños recordatorios de cuánto los amo.</p>
        </div>
    </div>

    <div id="cafe-modal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('cafe-modal')">&times;</span>
            <h2>☕ Café</h2>
            <p>La estética de un café bonito es donde me encuentro a mí misma. Luz cálida, tazas de cerámica, el aroma del café, una mesa pequeña, libros abiertos. Es donde pienso, donde escribo, donde observo a otros vivir sus vidas.</p>
        </div>
    </div>

    <div id="ajedrez-modal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('ajedrez-modal')">&times;</span>
            <h2>♟️ Ajedrez</h2>
            <p>El ajedrez es hermoso porque combina estrategia, arte y movimiento. No es solo un juego; es una metáfora de la vida. Cada pieza tiene su propósito, cada movimiento tiene consecuencias.</p>
        </div>
    </div>

    <div id="libros-modal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('libros-modal')">&times;</span>
            <h2>📚 Libros</h2>
            <p>Los libros son puertas a otros mundos. Me encantan historias con personajes complejos, romance verdadero, psicología profunda, mitología reinterpretada. "La Canción de Aquiles" es especial porque captura algo que pocas historias logran: la profundidad de una conexión.</p>
        </div>
    </div>

    <div id="musica-modal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('musica-modal')">&times;</span>
            <h2>🎵 Música</h2>
            <p>La música es la voz de mi alma. BTS porque me acompañó en momentos importantes. Harry Styles porque su arte es poesía. Música instrumental misteriosa porque a veces solo necesito suspenso en el silencio. La música es lo más importante.</p>
        </div>
    </div>

    <div id="anime-modal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('anime-modal')">&times;</span>
            <h2>👹 Anime & Series</h2>
            <p>Me encantan historias que exploran la complejidad humana. Arcane porque cada personaje es más que blanco y negro. Ghibli por la belleza en lo mágico. Naruto por los personajes oscuros que al final resultan ser los más interesantes.</p>
        </div>
    </div>

    <script>
        // MODAL FUNCTIONS
        function openModal(modalId) {
            document.getElementById(modalId).classList.add('show');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('show');
        }

        window.onclick = function(event) {
            if (event.target.classList.contains('modal')) {
                event.target.classList.remove('show');
            }
        }

        // SMOOTH SCROLL
        function smoothScroll(target) {
            document.querySelector(target).scrollIntoView({
                behavior: 'smooth'
            });
        }

        // EASTER EGGS
        function showEaster(type) {
            const messages = {
                'bts': '💜 Taehyung es mi bias. Hay algo en él que resuena conmigo.',
                'egypt': '🏺 Mitología egipcia: historias de poder, deseo y conexión.',
                'slipknot': '🎭 Lo raro es hermoso. Slipknot es mi lado más oscuro.',
                'achilles': '💕 "La canción de Aquiles" es un libro que vive en mi corazón.'
            };

            if (messages[type]) {
                alert(messages[type]);
            }
        }

        // QUOTES ROTATION
        const quotes = [
            '"Los personajes complejos son los que permanecen en el corazón"',
            '"Un café, un libro y silencio. Eso es felicidad"',
            '"La música es la voz de lo que no puedo decir con palabras"',
            '"Los gatos entienden las almas tranquilas"',
            '"La mitología es la historia de quiénes somos realmente"',
            '"En el ajedrez, como en la vida, hay belleza en la estrategia"',
            '"Introvertida pero con un universo infinito adentro"'
        ];

        let currentQuoteIndex = 0;

        function rotateQuote() {
            currentQuoteIndex = (currentQuoteIndex + 1) % quotes.length;
            const quoteDisplay = document.getElementById('quote-display');
            quoteDisplay.style.opacity = '0';
            setTimeout(() => {
                quoteDisplay.textContent = quotes[currentQuoteIndex];
                quoteDisplay.style.opacity = '1';
            }, 150);
        }

        // HEART TRAIL ON CLICK
        document.addEventListener('click', function(e) {
            if (e.target.tagName !== 'A') {
                createHeart(e.pageX, e.pageY);
            }
        });

        function createHeart(x, y) {
            const heart = document.createElement('div');
            heart.className = 'heart-trail';
            heart.innerHTML = '💗';
            heart.style.left = x + 'px';
            heart.style.top = y + 'px';
            document.body.appendChild(heart);

            setTimeout(() => heart.remove(), 1000);
        }

        // SUBTLE CAT CURSOR TRAIL (optional - every 30px)
        let lastX = 0, lastY = 0;
        const cursorCat = document.getElementById('cursor-cat');
        const cats = ['🐱', '😸', '😻', '🐈'];
        let catIndex = 0;

        document.addEventListener('mousemove', function(e) {
            if (Math.abs(e.clientX - lastX) > 30 || Math.abs(e.clientY - lastY) > 30) {
                cursorCat.style.left = e.clientX + 'px';
                cursorCat.style.top = e.clientY + 'px';
                cursorCat.textContent = cats[catIndex % cats.length];
                catIndex++;
                lastX = e.clientX;
                lastY = e.clientY;
            }
        });

        // SMOOTH ANIMATIONS ON SCROLL
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.animation = 'fadeInUp 0.6s ease-out';
                }
            });
        }, observerOptions);

        document.querySelectorAll('.love-card, .universe-item, .artist-card, .book, .cat-card').forEach(el => {
            observer.observe(el);
        });

        // Add fade-in animation for initial load
        const style = document.createElement('style');
        style.textContent = `
            .love-card, .universe-item, .artist-card, .book, .cat-card {
                opacity: 0;
                animation: fadeInUp 0.6s ease-out forwards;
            }
        `;
        document.head.appendChild(style);

        // QUOTE TRANSITION CSS
        const quoteStyle = document.createElement('style');
        quoteStyle.textContent = `
            .quote-text {
                transition: opacity 0.3s ease;
            }
        `;
        document.head.appendChild(quoteStyle);
    </script>
</body>
</html>