    <!-- CAT SECTION -->
    <section class="cat-section" id="gatos">
        <h2 class="section-title">Cat Café</h2>
        <p style="text-align: center; color: var(--burgundy); margin-bottom: 2rem; font-size: 1rem;">
            Mi lugar feliz: gatos + luz cálida + silencio perfecto
        </p>
        <div class="cat-grid">
            <div class="cat-card">
                <div class="cat-emoji">🐱</div>
                <h4>Michi</h4>
                <p>Mi gato más bonito. Elegante, observador, siempre sabe qué necesito.</p>
            </div>
            <div class="cat-card">
                <div class="cat-emoji">🐈</div>
                <h4>Mitsubishi (Mitsu)</h4>
                <p>El travieso, el que me trae sorpresas a las 3 de la mañana. Mi caos favorito.</p>
            </div>
            <div class="cat-card">
                <div class="cat-emoji">🐈‍⬛</div>
