    <!-- MODALS -->
    <div id="gatos-modal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('gatos-modal')">&times;</span>
            <h2>Michi, Mitsu y Tsuru</h2>
            <p>Son mi santuario. Cada uno tiene su propia magia: Michi con su elegancia silenciosa, Mitsu con su energía caótica, Tsuru con su rareza que solo yo entiendo. No sé qué haría sin ellos.</p>
        </div>
    </div>

    <div id="cafe-modal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('cafe-modal')">&times;</span>
            <h2>El ritual del café</h2>
            <p>Es donde me encuentro. Esa mesa pequeña en la esquina, una taza cálida entre mis manos, un libro abierto. La luz cálida colándose por la ventana. Es ahí donde pienso, donde escritura, donde simplemente existo sin tener que explicar nada.</p>
        </div>
    </div>

    <div id="ajedrez-modal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('ajedrez-modal')">&times;</span>
            <h2>El juego de la vida</h2>
            <p>El ajedrez no es solo un juego para mí. Es estrategia, es arte en movimiento, es la vida misma comprimida en 64 casillas. Cada pieza tiene valor, cada movimiento tiene peso. Eso es hermoso.</p>
        </div>
    </div>

    <div id="libros-modal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('libros-modal')">&times;</span>
            <h2>Historias que atrapan el alma</h2>
            <p>No me interesan historias simples. Quiero personajes rotos, amores que duelen de verdad, psicología del corazón humano. "La Canción de Aquiles" lo entiende. Ennead lo entiende. Son mis compañeros de insomnio.</p>
        </div>
    </div>

    <div id="musica-modal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('musica-modal')">&times;</span>
            <h2>Mi lenguaje</h2>
            <p>La música es la voz de lo que no puedo decir con palabras. BTS me acompañó en momentos que importan. Harry Styles es poesía. Hay un misterio sonoro en ciertos artistas que me hipnotiza. La música es lo más importante.</p>
        </div>
    </div>

    <div id="anime-modal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('anime-modal')">&times;</span>
            <h2>Personajes que rompen esquemas</h2>
            <p>Arcane porque cada personaje es gris, no hay blanco ni negro. Ghibli porque la belleza existe en lo mágico y lo roto. Naruto porque los personajes "villanos" resultan ser los más interesantes. Eso es lo que me fascina.</p>
        </div>
    </div>

    <script>
        // MODALES
        function openModal(modalId) {
            document.getElementById(modalId).classList.add('show');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('show');
        }

        window.onclick = function(event) {
            if (event.target.classList.contains('modal')) {
                event.target.classList.remove('show');
            }
        }

        // SMOOTH SCROLL
        function smoothScroll(target) {
            document.querySelector(target).scrollIntoView({
                behavior: 'smooth'
            });
        }

        // EASTER EGGS
        function showEaster(type) {
            if (type === 'achilles') {
                alert('"La Canción de Aquiles" es el libro que vive en mi corazón. Patroclus y Aquiles me enseñaron qué es amar sin filtros.');
            }
        }

        // CITAS ROTATIVAS
        const quotes = [
            '"Un personaje complicado es un libro que nunca termino de leer"',
            '"Un café, un libro y silencio. Eso es lo más cercano a la felicidad"',
            '"La música es la voz de lo que no puedo decir con palabras"',
            '"Michi, Mitsu y Tsuru son mis razones para seguir"',
            '"Introvertida, pero con un universo infinito adentro"',
            '"Creo en los personajes rotos, en los amores que duelen, en las historias raras"',
            '"El ajedrez es vida comprimida en 64 casillas"',
            '"Ghibli entiende lo mágico. Arcane entiende lo gris. Naruto entiende lo complejo"'
        ];

        let currentQuoteIndex = 0;

        function rotateQuote() {
            currentQuoteIndex = (currentQuoteIndex + 1) % quotes.length;
            const quoteDisplay = document.getElementById('quote-display');
            quoteDisplay.style.opacity = '0';
            setTimeout(() => {
                quoteDisplay.textContent = quotes[currentQuoteIndex];
                quoteDisplay.style.opacity = '1';
            }, 150);
        }

        // CORAZONES AL CLICKEAR
        document.addEventListener('click', function(e) {
            if (e.target.tagName !== 'A') {
                createHeart(e.pageX, e.pageY);
            }
        });

        function createHeart(x, y) {
            const heart = document.createElement('div');
            heart.className = 'heart-trail';
            heart.innerHTML = '💗';
            heart.style.left = x + 'px';
            heart.style.top = y + 'px';
            document.body.appendChild(heart);

            setTimeout(() => heart.remove(), 1000);
        }

        // GATITO QUE SIGUE EL CURSOR
        let lastX = 0, lastY = 0;
        const cursorCat = document.getElementById('cursor-cat');
        const cats = ['🐱', '😸', '😻'];
        let catIndex = 0;

        document.addEventListener('mousemove', function(e) {
            if (Math.abs(e.clientX - lastX) > 30 || Math.abs(e.clientY - lastY) > 30) {
                cursorCat.style.left = e.clientX + 'px';
                cursorCat.style.top = e.clientY + 'px';
                cursorCat.textContent = cats[catIndex % cats.length];
                catIndex++;
                lastX = e.clientX;
                lastY = e.clientY;
            }
        });
    </script>
</body>
</html>