                <p>Cariñoso y curioso</p>
            </div>
            <div class="cat-card">
                <div class="cat-emoji">🐈‍⬛</div>
                <h4>Gato 3</h4>
                <p>Misterioso y elegante</p>
            </div>
        </div>
    </section>

    <!-- EASTER EGGS SECTION (Hidden) -->
    <section style="position: relative;">
        <h2 class="section-title">Secretos escondidos</h2>
        <div style="text-align: center; color: var(--dusty-rose); margin: 2rem 0;">
            <p>Intenta hacer click en elementos que se vean especiales...</p>
            <p style="font-size: 0.9rem; margin-top: 1rem;">Hay easter eggs escondidos para Viktor 🧿, Obito 🍂, Ghibli 🌸 y más</p>
